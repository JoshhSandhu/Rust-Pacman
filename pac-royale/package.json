{
  "name": "pac-royale",
  "version": "0.1.0",
  "description": "Pac-Royale: Endless Pac-Man on Ephemeral Rollups",
  "scripts": {
    "test": "anchor test",
    "test:smoke": "anchor test -- --grep \"demo smoke\"",
    "build": "anchor build",
    "deploy": "anchor deploy",
    "init": "ts-node --transpile-only scripts/deploy-and-init.ts",
    "ghost:crank": "ts-node --transpile-only scripts/ghostCrank.ts",
    "demo:health": "ts-node --transpile-only scripts/demo-health-check.ts",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "^0.8.5",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.6",
    "mocha": "^9.2.0",
    "prettier": "^3.0.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
